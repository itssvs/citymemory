# CityMemory, small version for free hosts with about 512 MB of memory (e.g. Render free).
# Same app and data; complaint matching uses the built-in text model instead of the
# multilingual AI model, and AI summaries are off unless an LLM API is configured.

# ---- 1. build the website ----
FROM node:22-slim AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# ---- 2. run the API, which also serves the website ----
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 \
    CITYMEMORY_EMBEDDER=hash \
    CITYMEMORY_DEMO=1 \
    LLM_ENABLED=off
WORKDIR /app
COPY backend/requirements-lite.txt backend/requirements-lite.txt
RUN pip install --no-cache-dir -r backend/requirements-lite.txt
COPY backend/ backend/
COPY --from=web /web/dist frontend/dist
WORKDIR /app/backend
EXPOSE 10000
# the host sets PORT; the demo database is created and seeded on first start
CMD ["sh", "-c", "python -m uvicorn main:app --host 0.0.0.0 --port ${PORT:-10000}"]
